+#if defined(__ANDROID__)
+// ── Custom Adreno driver support (libadrenotools) ────────────────────────────
+//
+// plume owns the Vulkan loader on Android (volk). When the app activates a
+// custom Adreno driver (Mesa turnip etc.) via files/drivers/active.txt,
+// LibertyRecomp's JNI glue exports REX_VULKAN_LOADER_PATH (the driver .so
+// path) and REX_ANDROID_NATIVE_LIB_DIR (nativeLibraryDir, home of
+// libadrenotools.so + its hook libraries). In that case volk is initialized
+// against adrenotools' hooked loader — which is the system libvulkan.so
+// opened inside a linker namespace that redirects driver loading to the
+// custom Turnip .so — so the instance, device, Android surface and swapchain
+// created by this file all run on the custom driver.
+//
+// Any failure falls back to the system loader via volkInitialize(); the
+// outcome is written to <files>/drivers/last_boot.txt for the app UI.
+#include <android/log.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <string>
+
+namespace plume {
+namespace {
+
+void RexWriteDriverBootOutcome(const char *status, const char *driver, const char *error) {
+    const char *files_dir = std::getenv("REX_ANDROID_FILES_DIR");
+    if (!files_dir || !*files_dir) return;
+    char path[512];
+    std::snprintf(path, sizeof(path), "%s/drivers/last_boot.txt", files_dir);
+    FILE *f = std::fopen(path, "w");
+    if (!f) return;
+    std::fprintf(f, "status=%s\ndriver=%s\nerror=%s\n",
+                 status ? status : "unknown", driver ? driver : "-",
+                 error ? error : "-");
+    std::fclose(f);
+    __android_log_print(ANDROID_LOG_INFO, "plume",
+                        "Vulkan driver boot outcome: %s (%s) %s", status,
+                        driver ? driver : "-", error ? error : "-");
+}
+
+// Returns VK_SUCCESS after volk has been initialized (custom driver when
+// active, system loader otherwise); a VK_ERROR_* result means volkInitialize
+// itself failed and the caller should abort.
+VkResult RexAdrenotoolsVolkInitialize() {
+    using OpenLibvulkanFn = void *(*)(int, int, const char *, const char *,
+                                      const char *, const char *, const char *,
+                                      void **);
+    const char *loader_path = std::getenv("REX_VULKAN_LOADER_PATH");
+    if (!loader_path || !*loader_path) {
+        return volkInitialize();  // no custom driver — system loader (normal path)
+    }
+    const char *native_lib_dir = std::getenv("REX_ANDROID_NATIVE_LIB_DIR");
+    if (!native_lib_dir || !*native_lib_dir) {
+        RexWriteDriverBootOutcome("custom_failed", loader_path, "native lib dir unknown");
+        return volkInitialize();
+    }
+
+    std::string adrenotools_path =
+        std::string(native_lib_dir) + "/libadrenotools.so";
+    void *adrenotools = dlopen(adrenotools_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!adrenotools) {
+        RexWriteDriverBootOutcome("custom_failed", loader_path, dlerror());
+        return volkInitialize();
+    }
+
+    auto open_libvulkan = reinterpret_cast<OpenLibvulkanFn>(
+        dlsym(adrenotools, "adrenotools_open_libvulkan"));
+    if (!open_libvulkan) {
+        RexWriteDriverBootOutcome("custom_failed", loader_path,
+                                  "adrenotools_open_libvulkan missing");
+        return volkInitialize();
+    }
+
+    // adrenotools concatenates dir + name WITHOUT inserting a separator, so
+    // the directory part must keep its trailing '/'.
+    std::string driver_path(loader_path);
+    const size_t last_slash = driver_path.find_last_of('/');
+    std::string driver_name =
+        last_slash == std::string::npos ? driver_path : driver_path.substr(last_slash + 1);
+    std::string driver_dir = driver_path.substr(0, last_slash + 1);
+
+    // ADRENOTOOLS_DRIVER_CUSTOM == 1 << 0. tmpLibDir is only needed on API < 29
+    // (no memfd); the app requires API 26 but drivers on 26-28 would need it —
+    // adrenotools returns null there and we fall back cleanly.
+    constexpr int kAdrenoToolsDriverCustom = 1 << 0;
+    void *handle = open_libvulkan(RTLD_NOW, kAdrenoToolsDriverCustom, nullptr,
+                                  native_lib_dir, driver_dir.c_str(),
+                                  driver_name.c_str(), nullptr, nullptr);
+    if (!handle) {
+        RexWriteDriverBootOutcome("custom_failed", driver_name.c_str(),
+                                  "adrenotools_open_libvulkan returned null (see hook_impl in logcat)");
+        return volkInitialize();
+    }
+
+    auto vkGetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+        dlsym(handle, "vkGetInstanceProcAddr"));
+    if (!vkGetInstanceProcAddr) {
+        RexWriteDriverBootOutcome("custom_failed", driver_name.c_str(),
+                                  "vkGetInstanceProcAddr missing from loader");
+        return volkInitialize();
+    }
+
+    volkInitializeCustom(vkGetInstanceProcAddr);
+    RexWriteDriverBootOutcome("custom_ok", driver_name.c_str(), "-");
+    return VK_SUCCESS;
+}
+
+}  // namespace
+}  // namespace plume
+#endif  // __ANDROID__
